# 复制为 renew.env（同目录，被 gitignore 忽略）后填写
# Apple TV 的 UDID：xcrun devicectl list devices 查看 Identifier 列
DYTV_DEVICE=12345678-90AB-CDEF-1234-567890ABCDEF
# xcodeproj 的绝对路径（按你的 clone 位置修改）
DYTV_PROJ=/path/to/dytv/apple-tv/DouyinTV.xcodeproj
# Xcode 里的 scheme 名
DYTV_SCHEME=DouyinTV
# Provisioning profile 名包含的标识片段（一般用你的 Bundle ID）
DYTV_PROFILE_KEY=com.yourname.dytv
# 设备在 Xcode 里的目标名（默认 appletv）
# DYTV_DEVICE_NAME=appletv
# 可选：与其他自动续签任务互斥的锁目录
# DYTV_WAIT_LOCK=/tmp/other-renew.lock

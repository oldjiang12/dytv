# 复制为 .env（setup 会自动生成）。mac.sh 读取这个文件；已存在的环境变量优先
# 每行写成 KEY=VALUE，不要在行尾加注释
BIND_HOST=0.0.0.0
BIND_PORT=8055
# 留空表示 /login 不设防。setup 首次运行会生成随机值
ADMIN_TOKEN=
# 默认 server/user_data
# USER_DATA_DIR=
# 使用 Clash 或 Surge 的 fake-ip 模式时设为 1（DoH 二次核验仍然生效）
# ALLOW_FAKE_IP=1
# LOW_WM=15
# HIGH_WM=40
# DYTV_ACCESS_LOG=1
# PIP_INDEX_URL=
# PLAYWRIGHT_DOWNLOAD_HOST=
# TZ=Asia/Shanghai
